#!/bin/bash
# After the SAM and DA3 extractions finish: dense probes on their tokens, zero-shot ceilings, report rebuild.
cd /home/a1905721/workspace/OpenWAM
L=artifacts/logs/specialists_pipeline.log
while screen -ls | grep -qE "\.(sam_extract|da3_extract)\b"; do sleep 120; done
for e in agilex franka; do for r in sam da3; do
    n=$(ls artifacts/${e}_features_gt/$r 2>/dev/null | wc -l); echo "$(date) $e $r: $n npz" >> $L
done; done
echo "$(date) extraction finished; probes" >> $L
bash run/probe_dense_layers.sh sam agilex franka >> $L 2>&1
bash run/probe_dense_layers.sh da3 agilex franka >> $L 2>&1
/home/a1905721/.conda/envs/d4rt/bin/python scripts/collect_zeroshot.py >> $L 2>&1
/home/a1905721/.conda/envs/d4rt/bin/python scripts/build_probe_report.py >> $L 2>&1
/home/a1905721/.conda/envs/d4rt/bin/python scripts/build_probe_pdf.py >> $L 2>&1
echo "$(date) specialists pipeline complete" >> $L
