============================================================
OpenWAM Training
============================================================
model:
  video_backbone:
    encoder:
      name: wan22_vae
      model_path: /path/to/Wan2.2-TI2V-5B
    name: wan22_ti2v_5b
    model_path: assets/video_backbone_ckpt/Wan2.2-TI2V-5B
    from_scratch: false
    shift_video: 5.0
  action_backbone:
    dim: 1024
    ffn_dim: 4096
    shift_action: 5.0
  freeze:
  - video_backbone.text_encoder
  - video_backbone.reason1
  - video_backbone.vae
  - video_backbone.image_encoder
  - video_backbone.video_encoder
  architecture:
    framework: dual_system
    variant: joint_self_attn
    action_dim: 80
    use_proprioception: true
    state_dim: 80
    attention_mask_mode: action_sees_video
    video_attention_mask_mode: first_frame_causal
    action_film: false
    film_cond_dim: 2048
    film_type: mean
    film_token_reduction: 8
    film_num_action_tokens: null
    bridge_layers: null
    bridge_interval: 1
    mot_checkpoint_mixed_attn: true
    detach_bridge: false
    detach_video: false
    bridge_noise:
      enabled: false
      p_clean: 0.3
      ratio_min: 0.1
      ratio_max: 0.2
      block: 2
      future_weight: 2.5
      gauss_prob: 0.5
      sigma_min: 0.5
      sigma_max: 1.5
      seed: 0
    idm_video_cond_noise_prob: 0.5
dataloader:
  type: wamu_real
  dataset_dir: ${oc.env:OPEN_WAM_WAMU_REAL_DATA,datasets/lishanyang_wamu_real}
  embodiment: aloha-agilex
  variant: both
  action_mode: joint
  unify_action: true
  unify_action_map:
  - 0-6
  - 34-40
  unify_state_map: null
  num_frames: 33
  video_stride: 4
  window_stride: 1
  split: train
  height: 384
  width: 320
  multiview: true
  camera_layout:
  - observation.images.top
  - observation.images.left_wrist
  - observation.images.right_wrist
  target_camera: observation.images.top
  normalize_mode: quantile
  color_jitter:
    enabled: true
    brightness: 0.2
    contrast: 0.2
    saturation: 0.2
    hue: 0.0
  normalization_stats_path: ${dataloader.dataset_dir}/meta/stats.json
  tasks:
  - bowls
training:
  debug: false
  learning_rate: 0.0001
  adam_betas:
  - 0.9
  - 0.95
  weight_decay: 0.01
  max_grad_norm: 1.0
  num_epochs: null
  max_steps: 20000
  batch_size: 16
  gradient_accumulation_steps: 2
  lr_scheduler: cosine
  warmup_ratio: 0.05
  lr_min_ratio: 0.01
  action_lr: null
  video_lr: null
  mixed_precision: bf16
  zero_stage: 2
  use_gradient_checkpointing: true
  use_gradient_checkpointing_offload: false
  initialize_model_on_cpu: false
  offload_optimizer_device: none
  lambda_video: 1.0
  lambda_action: 1.0
  max_timestep_boundary: 1.0
  min_timestep_boundary: 0.0
  output_path: /scratch/zv32/rz6525/WAMU/outputs/wamu_real_pretrain_cotrain_single_task_bowls
  save_steps: 3000
  save_full_states_for_resume: false
  keep_last_k_ckpts: 4
  finetune_ckpt_path: /scratch/zv32/rz6525/WAMU/OpenWAM/pretrain_ego_robot_cotrain_action_sees_video
  resume_ckpt_path: null
  dataset_num_workers: 8
project:
  name: openwam-wamu-real
  wandb:
    enabled: false
    project: openwam-wamu-real

